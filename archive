        function init3DTiltEffect() {
            const cardArea=document.getElementById('card3DArea');
            const cassette=document.getElementById('cassetteBox');
            function followPointer(e) {
                const rect=cardArea.getBoundingClientRect();
                const nx=Math.max(-1,Math.min(1,(e.clientX-rect.left-rect.width/2)/(rect.width/2)));
                const ny=Math.max(-1,Math.min(1,(e.clientY-rect.top-rect.height/2)/(rect.height/2)));
                paintCassetteTilt(-ny*24,nx*28);
            }
            cardArea.addEventListener('pointerenter',e=>{if(e.pointerType!=='touch') followPointer(e);});
            cardArea.addEventListener('pointermove',e=>{
                if(cardMotion.dragging && e.pointerId===cardMotion.pointerId){
                    const dx=e.clientX-cardMotion.startX,dy=e.clientY-cardMotion.startY;
                    if(Math.hypot(dx,dy)>8) cardMotion.moved=true;
                    paintCassetteTilt(cardMotion.originX-dy*.65,cardMotion.originY+dx*.8);
                } else if(e.pointerType!=='touch') followPointer(e);
            });
            cassette.addEventListener('pointerdown',e=>{
                if(e.button!==0) return;
                if(cassette.classList.contains('cassette-auto-spin')) toggle3DAutoSpin();
                Object.assign(cardMotion,{dragging:true,pointerId:e.pointerId,startX:e.clientX,startY:e.clientY,originX:cardMotion.x,originY:cardMotion.y,moved:false});
                cassette.setPointerCapture(e.pointerId);
            });
            cardArea.addEventListener('pointerup',e=>{
                if(e.pointerId!==cardMotion.pointerId) return;
                const dragged=cardMotion.moved;
                cardMotion.dragging=false; cardMotion.pointerId=null;
                if(dragged) cardMotion.suppressClickUntil=performance.now()+400;
                else flipCassetteCard(true);

                if(cassette.hasPointerCapture(e.pointerId)) cassette.releasePointerCapture(e.pointerId);
                const rect=cardArea.getBoundingClientRect();
                if(e.pointerType==='touch'||e.clientX<rect.left||e.clientX>rect.right||e.clientY<rect.top||e.clientY>rect.bottom) resetCassetteTilt();
            });
            cardArea.addEventListener('pointerleave',()=>{if(!cardMotion.dragging) resetCassetteTilt();});
            cardArea.addEventListener('pointercancel',resetCassetteTilt);
            cassette.addEventListener('lostpointercapture',()=>{if(cardMotion.dragging) resetCassetteTilt();});

