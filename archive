<div id="starBurstLayer" class="star-burst-layer" aria-hidden="true"></div>
<script>
(() => {
    const layer=document.getElementById('starBurstLayer');
    const lessMotion=matchMedia('(prefers-reduced-motion: reduce)');
    function burst(target,event){
        const bounds=target.getBoundingClientRect();
        const pointer=event.type==='click'&&event.detail>0;
        const x=pointer?event.clientX:bounds.left+bounds.width/2;
        const y=pointer?event.clientY:bounds.top+bounds.height/2;
        const count=lessMotion.matches?8:38;
        while(layer.children.length>114)layer.firstElementChild.remove();
        for(let i=0;i<count;i++){
            const star=document.createElement('span');star.className='click-star';
            const size=3+Math.random()*12,angle=Math.PI*2*i/count+Math.random()*.25;
            const distance=(lessMotion.matches?22:100)+Math.random()*(lessMotion.matches?15:280);
            const dx=Math.cos(angle)*distance,dy=Math.sin(angle)*distance;
            star.style.setProperty('--star-size',size+'px');
            star.style.left=(x-size/2)+'px';star.style.top=(y-size/2)+'px';layer.append(star);
            const animation=star.animate([
                {transform:'translate(0,0) scale(.25) rotate(0deg)',opacity:0},
                {transform:`translate(${dx*.16}px,${dy*.16}px) scale(1) rotate(25deg)`,opacity:1,offset:.12},
                {transform:`translate(${dx}px,${dy+38}px) scale(.1) rotate(${90+Math.random()*100}deg)`,opacity:0}
            ],{duration:lessMotion.matches?350:1100+Math.random()*700,easing:'cubic-bezier(.16,.7,.3,1)',fill:'forwards'});
            animation.onfinish=()=>star.remove();animation.oncancel=()=>star.remove();
        }
    }
    document.addEventListener('click',event=>{
        const target=event.target.closest('#vhsTrack .vhs-spine,.timeline-card');
        if(!target)return;
        if(target.matches('.vhs-spine')&&typeof hasDraggedFar!=='undefined'&&hasDraggedFar)return;
        burst(target,event);
    },{capture:true});
    document.addEventListener('keydown',event=>{
        const target=event.target.closest('.timeline-card');
        if(target&&!event.repeat&&(event.key==='Enter'||event.key===' '))burst(target,event);
    },{capture:true});
})();
</script>


