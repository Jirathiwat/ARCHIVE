<script>
// Delegate hover lighting so dynamically rendered project cards participate.
(() => {
    let hoverFrame = 0, target = null, pointerX = 0, pointerY = 0;
    document.addEventListener('pointermove', event => {
        if (event.pointerType === 'touch') return;
        target = event.target.closest('.timeline-card,.chapter-block,.contact-card,#vhsTrack .vhs-spine');
