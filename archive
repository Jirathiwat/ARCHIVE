        const storyFields = [["status", "สถานะปัจจุบัน"], ["technologies", "เทคโนโลยีที่ใช้"], ["motivation", "จุดเริ่มต้น / ทำไมถึงทำ"], ["role", "ส่วนที่ผมลงมือทำ"], ["process", "กระบวนการ / สิ่งที่ลอง"], ["problem", "ปัญหาที่พบ"], ["solution", "วิธีแก้ / สิ่งที่ปรับ"], ["lessons", "สิ่งที่ได้เรียนรู้"], ["next", "สิ่งที่อยากทำต่อ"], ["evidence", "หลักฐาน / ลิงก์ผลงาน"]];
