        const rect=card.querySelector('.contact-icon').getBoundingClientRect();
        const particle=document.createElement('span');particle.className='social-float';
        particle.style.left=(rect.left+rect.width/2-15)+'px';
        particle.style.top=(rect.top+rect.height/2-15)+'px';
        particle.style.setProperty('--float-color',getComputedStyle(card).getPropertyValue('--contact-color'));
        const glyph=document.createElement('i');glyph.className=icon.className;particle.append(glyph);layer.append(particle);
        const drift=(Math.random()-.5)*170, rise=90+Math.random()*95,turn=(Math.random()-.5)*45;
        const motion=particle.animate([
            {transform:'translate(0,0) scale(.45)',opacity:0},
            {transform:`translate(${drift*.2}px,${-rise*.2}px) scale(.85)`,opacity:.75,offset:.2},
            {transform:`translate(${drift}px,${-rise}px) scale(1.15) rotate(${turn}deg)`,opacity:0}
        ],{duration:1500+Math.random()*500,easing:'cubic-bezier(.2,.65,.35,1)',fill:'forwards'});
        motion.onfinish=()=>particle.remove();motion.oncancel=()=>particle.remove();
    }
    document.addEventListener('pointerover',event=>{
        if(event.pointerType==='touch'||reduced.matches)return;
        const next=event.target.closest('.contact-card');
        if(!next||next===card)return;
        stop();card=next;emit();timer=setInterval(emit,320);
    },{passive:true});
    document.addEventListener('pointerout',event=>{
        if(card&&card.contains(event.target)&&!card.contains(event.relatedTarget))stop();
    },{passive:true});
    window.addEventListener('blur',stop);window.addEventListener('scroll',stop,{passive:true});
    document.addEventListener('visibilitychange',()=>{if(document.hidden)stop();});
})();
</script>

</body>
</html>
