            overflow: hidden;
            user-select: none;
            -webkit-user-select: none;
            touch-action: pan-y;
        }

        /* CRT Screen Effect Overlay */
        .crt-overlay::before {
            content: " ";
            display: block;
            position: absolute;
            top: 0; left: 0; bottom: 0; right: 0;
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.06), rgba(0, 255, 0, 0.02), rgba(0, 0, 255, 0.06));
            z-index: 90;
            background-size: 100% 4px, 6px 100%;
            pointer-events: none;
        }

        /* Glitch Animation */
        @keyframes glitchAnim {
            0% { transform: translate(0) }
            20% { transform: translate(-2px, 2px) }
            40% { transform: translate(-2px, -2px) }
            60% { transform: translate(2px, 2px) }
            80% { transform: translate(2px, -2px) }
            100% { transform: translate(0) }
        }
        .glitch-flash {
            animation: glitchAnim 0.15s infinite;
        }

        /* 3D Perspective Viewport */
        .shelf-viewport {
            perspective: 1200px;
            overflow: hidden;
            width: 100vw;
            touch-action: none;
            z-index: 10;
        }

        .shelf-track {
            display: flex;
            align-items: center;
            transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
            transform-style: preserve-3d;
            position: absolute;
            left: 50%;
            will-change: transform;
        }

        .shelf-track.dragging {
            transition: none !important;
        }

        /* VHS Spine Styling */
        .vhs-spine {
            position: relative;
            transform-style: preserve-3d;
            transition: all 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            cursor: pointer;
            flex-shrink: 0;
            width: 72px; 
            height: 320px;
            margin: 0 8px;
        }

        .vhs-spine.active-spine {
            transform: translateZ(70px) scale(1.15);
            filter: brightness(1.25) drop-shadow(0 0 25px rgba(255, 238, 0, 0.7));
            z-index: 30;
        }

        .vhs-spine:not(.active-spine) {
            opacity: 0.35;
            filter: brightness(0.5) grayscale(30%);
        }

        /* 3D Card Hover & Flip Container */
        .card-perspective {
            perspective: 1000px;
        }

        .cassette-box {
            transform-style: preserve-3d;
            transition: transform 0.6s cubic-bezier(0.4, 0.2, 0.2, 1);
            will-change: transform;
        }

        

        .cassette-face {
            backface-visibility: hidden;
            -webkit-backface-visibility: hidden;
        }

        .cassette-back {
            transform: rotateY(180deg);
        }

        @keyframes cassetteSpin3D {
            0% { transform: rotateY(0deg) rotateX(10deg); }
            100% { transform: rotateY(360deg) rotateX(10deg); }
        }
        .cassette-auto-spin {
            animation: cassetteSpin3D 8s linear infinite !important;
        }

        @keyframes spinReel {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        .animate-reel {
            animation: spinReel 3s linear infinite;
        }

        :focus-visible { outline: 2px solid #FFEE00; outline-offset: 3px; }
        @media (max-width: 600px) { .vhs-spine { width: 64px; height: min(300px, 48vh); margin: 0 6px; } .shelf-viewport { min-height: 0; } }
