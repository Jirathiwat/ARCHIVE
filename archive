        }
        function setPortfolioView(view){
            document.querySelectorAll('[data-view]').forEach(btn=>{if(btn.dataset.view===view)btn.setAttribute('aria-current','page');else btn.removeAttribute('aria-current');});
            document.querySelector('.mobile-nav').value=view;
        }
        function navigatePortfolio(view){
            const section=document.getElementById(view);
            if(!section)return;
            stopAutoPlay();setPortfolioView(view);
            section.scrollIntoView({behavior:reducedMotion.matches?'auto':'smooth',block:'start'});
        }
        function renderPageSection(view){
            const missing='<p class="content-needed">[CONTENT NEEDED]</p>';
            const text={journey:['THE JOURNEY','แต่ละงาน พาไปเรียนรู้อะไร'],future:['NEXT CHAPTER','ยังมีเรื่องที่อยากลองสร้าง'],contact:['LET’S CONNECT','คุยกันต่อได้ที่นี่']}[view];
            if(!text)return;

            let body='';
            if(view==='journey'){
                const ordered=[...vhsTapes].sort((a,b)=>String(a.date).localeCompare(String(b.date)));
                body='<p class="story-lead">แต่ละก้าว มีเรื่องราวของการลงมือทำ</p><ol class="archive-timeline">'+ordered.map((t,i)=>`<li class="timeline-stop" style="--event-color:${safeColor(t.spineColor)}"><span class="timeline-node" aria-hidden="true"></span><article class="timeline-card" role="button" tabindex="0" aria-label="เปิดผลงาน ${escapeHTML(t.spineTitle)}" onclick="openJourneyTape(${t.id})" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();event.stopPropagation();openJourneyTape(${t.id});}"><div class="timeline-meta"><span class="timeline-year">${escapeHTML(t.date)}</span><span>${String(i+1).padStart(2,'0')} / ${escapeHTML(t.category)}</span></div><h3 class="timeline-project-title">${escapeHTML(t.spineTitle)} <span aria-hidden="true">↗</span></h3><p class="timeline-subtitle">${escapeHTML(t.subtitle||'')}</p>${t.award?`<span class="timeline-award">${escapeHTML(t.award)}</span>`:''}${t.story?.lessons?`<p class="timeline-lesson">${escapeHTML(t.story.lessons)}</p>`:''}</article></li>`).join('')+'</ol>';

            } else body=`<p class="story-lead">เริ่มบทสนทนาใหม่ไปด้วยกัน</p><div class="contact-grid">
              <a class="contact-card" style="--contact-color:#8ab7ff" href="https://www.facebook.com/jirathiwat01/" target="_blank" rel="noopener noreferrer"><span class="contact-icon"><i class="fa-brands fa-facebook-f" aria-hidden="true"></i></span><span class="contact-copy"><span class="contact-label">FACEBOOK</span><strong>จิราธิวัฒน์ ศิรวัฒน์เมธา</strong></span><span class="contact-arrow" aria-hidden="true">↗</span></a>
              <button type="button" class="contact-card" style="--contact-color:#99ebad" onclick="copyContact('0897296997',this)"><span class="contact-icon"><i class="fa-brands fa-line" aria-hidden="true"></i></span><span class="contact-copy"><span class="contact-label">LINE</span><strong>0897296997</strong></span><span class="contact-arrow" aria-hidden="true">↗</span></button>
              <a class="contact-card" style="--contact-color:#ecabdc" href="https://www.instagram.com/kings_heart_notbroken/" target="_blank" rel="noopener noreferrer"><span class="contact-icon"><i class="fa-brands fa-instagram" aria-hidden="true"></i></span><span class="contact-copy"><span class="contact-label">INSTAGRAM</span><strong>kings_heart_notbroken</strong></span><span class="contact-arrow" aria-hidden="true">↗</span></a>
            </div><p id="contactStatus" class="contact-status" role="status" aria-live="polite"></p>`;
            document.getElementById('section-'+view).innerHTML=body;
        }
